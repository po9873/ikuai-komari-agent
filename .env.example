# iKuai 连接（二选一）
# 方式一（推荐）：iKuai 4.0.222+ 个人 API 令牌
# 路由器后台 -> 登录管理 -> 个人 API 令牌 -> 添加（勾选负载监控/接口监控/终端监控等权限）
IKUAI_URL=https://192.168.1.1
IKUAI_API_TOKEN=粘贴你的令牌

# 方式二：账号密码（iKuai 3.x 兼容模式）
# IKUAI_USERNAME=admin
# IKUAI_PASSWORD=admin

# 通用
IKUAI_VERIFY_SSL=false
IKUAI_TIMEOUT=10

# Komari 面板
KOMARI_ENDPOINT=http://komari.example.com:25774
KOMARI_TOKEN=节点Token

# 上报间隔（秒）
REPORT_INTERVAL=3
BASIC_INTERVAL=300

# 流量月重置：0=不重置；1-28=每月N号将已用流量清零（同官方 agent --month-rotate）
MONTH_ROTATE=1
# 月流量基线持久化文件（容器内路径，建议挂载卷防止重启后当月流量归零重算）
STATE_FILE=/data/traffic_state.json
